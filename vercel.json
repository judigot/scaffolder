{
  "version": 2,
  "routes": [
    {
      "src": "/(hello|scaffold|introspect|getUserFiles|getUserFilesFromPublicRepo|create-local-files|create-github-file|github-token|executeCustomSchema)",
      "dest": "/src/index.ts"
    },
    {
      "src": "/(.*\\.(js|css|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|json))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "src/index.ts": {
      "maxDuration": 60
    }
  }
}
