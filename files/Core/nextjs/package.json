    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "oxlint": "^1.80.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
