# PostgreSQL connection used by Drizzle (`api/db`). Required for table routes.
DATABASE_URL=postgresql://user:password@localhost:5432/app

# Listen port for `next dev` / `next start` (golden tests set this).
PORT=3000

# Better Auth (compose `/Core/better-auth`). Secret must be at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
