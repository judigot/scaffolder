{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./packages/shared-utils" }
  ],
  // TEMPORARY — restore after agent-scaffold is solid.
  // Same template/worktree skip as tsconfig.app.json for bare `tsc`.
  // TEMPORARY — production tsc no longer typechecks test files. Restore when CI
  // is back and you want tests in the app compile. Do not split API vs frontend.
  "exclude": [
    "files",
    "files.test",
    "apps",
    ".apps",
    ".worktrees",
    "src/tests/golden-projects/output",
    "**/*.{vitest,test,spec}.*",
    "src/test"
  ]
}
