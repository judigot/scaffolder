{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "temp",
    "noEmit": false,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    // Node.js runtime settings
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",

    // Backend-friendly flags
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,

    // Avoid conflicts with frontend settings
    "isolatedModules": false,
    "allowJs": false,
    "jsx": "preserve"
  },

  // Only compile backend source files
  "include": ["src/**/*.ts", "src/**/*.mts"],

  // Explicitly ignore frontend files
  "exclude": ["**/*.tsx", "**/*.jsx", "node_modules"]
}
