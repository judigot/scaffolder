{
  "name": "bigbang",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "bun install && cross-env NODE_ENV=development VITE_BACKEND_PORT=5000 VITE_FRONTEND_PORT=3000 concurrently \"bunx --bun vite\" \"bun run --silent lint:watch\" \"bun --hot src/index.ts\" \"bun run --silent opencode:dev\"",
    "postinstall": "git config core.fileMode false",
    "dev:full": "bun install && docker compose up -d && cross-env NODE_ENV=development VITE_BACKEND_PORT=5000 VITE_FRONTEND_PORT=3000 concurrently \"bunx --bun vite\" \"bun run --silent lint:watch\" \"bun --hot src/index.ts\" \"bun run --silent opencode:dev\" \"sleep 2 && bun run generate:golden-apps\"",
    "dev with test": "docker compose up -d && cross-env NODE_ENV=development VITE_BACKEND_PORT=5000 VITE_FRONTEND_PORT=3000 concurrently \"bunx --bun vite\" \"bun run --silent test:watch\" \"bun run --silent lint:watch\" \"bun --hot src/index.ts\" \"bun run --silent opencode:dev\"",
    "opencode:dev": "bash -lc 'command -v opencode >/dev/null && dotenvx run -- opencode serve --hostname 127.0.0.1 --port 4096 || echo opencode-not-installed'",
    "opencode:old": "bash -lc 'command -v opencode >/dev/null && dotenvx run -- opencode serve --hostname 127.0.0.1 --port 4096 || echo opencode-not-installed'",
    "generate:golden-apps": "bun run scripts/generate-golden-apps.ts",
    "test:ci": "bash scripts/test-ci.sh",
    "test": "bun test --passWithNoTests",
    "test:watch": "bun test --watch --passWithNoTests",
    "vitest": "vitest --run",
    "test:playwright": "playwright test --project=chromium",
    "test:playwright:ui": "playwright test --ui",
    "lint": "echo 'Linting...' && bun run --silent lint:tsc && bun run --silent lint:eslint && printf \"\\033[1;32m✔ Linting complete — no errors found.\\033[0m\\n\" || exit 1",
    "lint:watch": "nodemon -q --watch src --ext js,ts,jsx,tsx --exec \"bun run --silent lint\"",
    "lint:tsc": "tsc --project tsconfig.app.json --noEmit",
    "type-check": "tsc --project tsconfig.app.json --noEmit",
    "build:vercel": "vercel build",
    "lint:biome": "biome lint --write src",
    "lint:biome:unsafe": "biome lint --write --unsafe src",
    "lint:oxlint": "oxlint --fix src",
    "lint:oxlint:unsafe": "oxlint --fix-dangerously src",
    "lint:migrate": "sh ./migrate_lint.sh",
    "lint:eslint": "eslint src --fix --report-unused-disable-directives --max-warnings 0",
    "dev:legacy": "vite & vitest & tsc --noEmit --watch & nodemon --exec tsx src/index.ts",
    "test:legacy": "vitest",
    "build:tsc": "tsc --project tsconfig.app.json --rootDir src --outDir api --noEmit false && tsc-alias -p tsconfig.app.json",
    "build:esbuild:new": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=api/index.js --minify --define:import.meta.env=process.env",
    "build:bun:new": "cross-env NODE_ENV=production bun build src/index.ts --outdir api --target node --format cjs --minify --define import.meta.env=process.env",
    "build:esbuild": "esbuild src/index.ts --minify --bundle --platform=node --format=esm --target=node20 --outfile=api/index.js --define:import.meta.env='process.env' --packages=external --external:path --external:process --minify",
    "build:bun": "cross-env NODE_ENV=production bun build src/index.ts --minify --outdir api --target node --format esm --external vite --external '@vitejs/*' --external express --external cors --external compression --external dotenv && node -e \"const fs=require('fs');const f='api/index.js';fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/import\\.meta\\.env/g,'process.env'))\"",
    "build": "bun run type-check && cross-env NODE_ENV=production vite build && bun run build:bun",
    "start": "cross-env NODE_ENV=production bun api/index.js",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky",
    "workspace:dev": "turbo run dev",
    "workspace:build": "turbo run build",
    "workspace:test": "turbo run test",
    "workspace:lint": "turbo run lint",
    "workspace:typecheck": "turbo run typecheck",
    "workspace:clean": "turbo run clean",
    "workspace:graph": "pnpm -r list --depth=0 --json | pnpm-deduplicate-check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "husky": {
    "hooks": {
      "pre-commit": "node .husky/pre-commit"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest --run --passWithNoTests"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.{css,scss,sass}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.18",
    "@ai-sdk/openai": "^3.0.18",
    "@ai-sdk/react": "^3.0.47",
    "@auth0/auth0-react": "^2.9.0",
    "@biomejs/biome": "^2.3.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hono/node-server": "^1.19.6",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/x-tree-view": "^8.19.0",
    "@octokit/rest": "^22.0.1",
    "@prettier/plugin-php": "0.23.0",
    "@tanstack/react-query": "^5.90.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.45",
    "auth0": "^4.37.0",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.0",
    "fast-deep-equal": "^3.1.3",
    "fflate": "^0.8.2",
    "hono": "^4.10.7",
    "json5": "^2.2.3",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "mysql2": "^3.15.3",
    "p-limit": "^7.2.0",
    "pg-pool": "^3.10.1",
    "pluralize": "^8.0.0",
    "prettier-plugin-java": "^2.7.7",
    "prettier-plugin-nginx": "^1.0.3",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-sql": "^0.19.2",
    "prettier-plugin-svelte": "^3.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "ssh2": "^1.17.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@dotenvx/dotenvx": "^1.52.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.1.0",
    "@happy-dom/global-registrator": "^20.4.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg-pool": "^2.0.6",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-type-assertion": "^1.3.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.7",
    "nodemon": "^3.1.11",
    "oxlint": "^1.30.0",
    "oxlint-tsgolint": "^0.10.1",
    "postcss": "^8.5.6",
    "postgres": "^3.4.8",
    "prettier": "^3.7.3",
    "sass": "^1.94.2",
    "sql-formatter": "^15.6.10",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.14"
  }
}
