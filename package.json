{
  "name": "bigbang",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "concurrently \"bunx --bun vite\" \"bun run --silent test:watch\" \"bun run --silent lint:watch\" \"bun --hot src/index.ts\"",
    "test": "bun test --passWithNoTests",
    "test:watch": "bun test --watch --passWithNoTests",
    "lint": "echo 'Linting...' && bun run --silent lint:tsc && bun run --silent lint:eslint && printf \"\\033[1;32m✔ Linting complete — no errors found.\\033[0m\\n\" || exit 1",
    "lint:watch": "nodemon -q --watch src --ext js,ts,jsx,tsx --exec \"bun run --silent lint\"",
    "lint:tsc": "tsc --project tsconfig.app.json --noEmit",
    "lint:biome": "biome lint --write src",
    "lint:oxlint": "oxlint src",
    "lint:eslint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "dev:legacy": "vite & vitest & tsc --noEmit --watch & nodemon --exec tsx src/index.ts",
    "test:legacy": "vitest",
    "build:tsc": "tsc --project tsconfig.app.json --rootDir src --outDir api --noEmit false && tsc-alias -p tsconfig.app.json",
    "build:esbuild": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=api/index.js --define:import.meta.env='process.env' --packages=external --external:path --external:process --minify",
    "build:api": "bun build src/index.ts --outdir api --target node --format esm --external express --external cors --external compression --external dotenv && node -e \"const fs=require('fs');const f='api/index.js';fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/import\\.meta\\.env/g,'process.env'))\"",
    "build": "vite build && pnpm run build:api",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky"
  },
  "husky": {
    "hooks": {
      "pre-commit": "node .husky/pre-commit"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest --run --passWithNoTests"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.{css,scss,sass}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.9.0",
    "@biomejs/biome": "^2.3.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/x-tree-view": "^7.29.10",
    "@octokit/rest": "^21.0.2",
    "@prettier/plugin-php": "^0.22.4",
    "@tanstack/react-query": "^5.90.5",
    "auth0": "^4.0.0",
    "axios": "^1.13.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "dotenv": "^16.6.1",
    "esbuild": "^0.27.0",
    "express": "^4.21.2",
    "fast-deep-equal": "^3.1.3",
    "fflate": "^0.8.2",
    "json5": "^2.2.3",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.1",
    "mysql2": "^3.15.3",
    "p-limit": "^7.2.0",
    "pg-pool": "^3.10.1",
    "pluralize": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-syntax-highlighter": "^15.6.6",
    "yaml": "^2.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@faker-js/faker": "^9.9.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg-pool": "^2.0.6",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-type-assertion": "^1.3.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.10",
    "oxlint": "^1.25.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "sql-formatter": "^15.6.10",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core"
  ]
}
