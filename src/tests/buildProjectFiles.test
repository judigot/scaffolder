            {
                "type": "file",
                "name": "products.php",
                "content": "<?php\n\nuse Illuminate\\Support\\Facades\\Route;\nuse App\\Http\\Controllers\\ProductController;\n\n// Custom routes for Product\nRoute::get(\\"products/{id}/order-products\\", [\n  ProductController::class,\n  \\"getOrderProducts\\",\n])->name(\\"products.order-products\\");\nRoute::get(\\"products/get-all-with-related-order-products\\", [\n  ProductController::class,\n  \\"getAllWithRelatedOrderProducts\\",\n])->name(\\"products.get-all-with-related-order-products\\");\nRoute::get(\\"products/{id}/orders\\", [\n  ProductController::class,\n  \\"getOrders\\",\n])->name(\\"products.orders\\");\nRoute::get(\\"products/get-all-with-related-orders\\", [\n  ProductController::class,\n  \\"getAllWithRelatedOrders\\",\n])->name(\\"products.get-all-with-related-orders\\");\n\n// Base routes\n// Chunk records for processing\n// http://127.0.0.1:8000/api/products/chunk - Processes data in chunks for better performance and memory usage\nRoute::post(\\"products/chunk\\", [ProductController::class, \\"chunk\\"])->name(\n  \\"products.chunk\\"\n);\n// Process each record individually\n// http://127.0.0.1:8000/api/products/each - Process each Product record individually\nRoute::post(\\"products/each\\", [ProductController::class, \\"each\\"])->name(\n  \\"products.each\\"\n);\n// Find or create a record\n// http://127.0.0.1:8000/api/products/first-or-create - Finds a Product record or creates it if not found\nRoute::post(\\"products/first-or-create\\", [\n  ProductController::class,\n  \\"firstOrCreate\\",\n])->name(\\"products.first-or-create\\");\n// Find or return a new record instance\n// http://127.0.0.1:8000/api/products/first-or-new - Finds a Product record or returns a new instance if not found\nRoute::post(\\"products/first-or-new\\", [\n  ProductController::class,\n  \\"firstOrNew\\",\n])->name(\\"products.first-or-new\\");\n// Retrieve related models\n// http://127.0.0.1:8000/api/products/get-with-relations - Retrieves Product resources with their related models\nRoute::get(\\"products/get-with-relations\\", [\n  ProductController::class,\n  \\"getWithRelations\\",\n])->name(\\"products.with-relations\\");\n// Retrieve a list of specific column values\n// http://127.0.0.1:8000/api/products/pluck - Retrieves a list of specific column values from Product resources\nRoute::get(\\"products/pluck\\", [ProductController::class, \\"pluck\\"])->name(\n  \\"products.pluck\\"\n);\n// Filter records between two values\n// http://127.0.0.1:8000/api/products/where-between - Filters Product resources where a column's value is between two specified values\nRoute::post(\\"products/where-between\\", [\n  ProductController::class,\n  \\"whereBetween\\",\n])->name(\\"products.where-between\\");\n// Filter records based on a set of values\n// http://127.0.0.1:8000/api/products/where-in - Retrieves Product resources where a column's value is in a given array\nRoute::post(\\"products/where-in\\", [ProductController::class, \\"whereIn\\"])->name(\n  \\"products.where-in\\"\n);\n// Filter records excluding a set of values\n// http://127.0.0.1:8000/api/products/where-not-in - Retrieves Product resources where a column's value is not in a given array\nRoute::post(\\"products/where-not-in\\", [\n  ProductController::class,\n  \\"whereNotIn\\",\n])->name(\\"products.where-not-in\\");\n// Create multiple records in a transaction with rollback support\n// http://127.0.0.1:8000/api/products/batch-create  - Creates multiple records in a single transaction with rollback support\nRoute::post(\\"products/batch-create \\", [\n  ProductController::class,\n  \\"batchCreateWithTransaction\\",\n])->name(\\"products.batch-create-transaction\\");\n// Batch update multiple records\n// http://127.0.0.1:8000/api/products/batch-update - Updates multiple Product records in a single request\nRoute::post(\\"products/batch-update\\", [\n  ProductController::class,\n  \\"batchUpdate\\",\n])->name(\\"products.batch-update\\");\n// Create or update a record\n// http://127.0.0.1:8000/api/products/update-or-create - Updates existing records or creates new ones if they don't exist\nRoute::post(\\"products/update-or-create\\", [\n  ProductController::class,\n  \\"updateOrCreate\\",\n])->name(\\"products.update-or-create\\");\n// Count records by criteria\n// http://127.0.0.1:8000/api/products/count?product_id=value&product_name=value - Counts Product resources matching specified criteria\nRoute::get(\\"products/count\\", [ProductController::class, \\"count\\"])->name(\n  \\"products.count\\"\n);\n// Check if a record exists\n// http://127.0.0.1:8000/api/products/exists?product_id=value&product_name=value - Checks if a Product resource exists based on provided criteria\nRoute::get(\\"products/exists\\", [ProductController::class, \\"exists\\"])->name(\n  \\"products.exists\\"\n);\n// Find a record by specific attributes\n// http://127.0.0.1:8000/api/products/find-by-attributes?product_id=1&product_id=value - Finds Product resources matching specific attributes\nRoute::get(\\"products/find-by-attributes\\", [\n  ProductController::class,\n  \\"findByAttributes\\",\n])->name(\\"products.find-by-attributes\\");\n// Paginate records\n// http://127.0.0.1:8000/api/products/paginate?page=1&per_page=10&product_id=value&sort=product_name&direction=desc - Returns paginated Product resources with pagination metadata\nRoute::get(\\"products/paginate\\", [ProductController::class, \\"paginate\\"])->name(\n  \\"products.paginate\\"\n);\n// Search records\n// http://127.0.0.1:8000/api/products/search?query=value&columns[]=product_id&columns[]=product_name - Searches for Product resources based on provided criteria\nRoute::get(\\"products/search\\", [ProductController::class, \\"search\\"])->name(\n  \\"products.search\\"\n);\n// Find multiple records by their IDs\n// http://127.0.0.1:8000/api/products/find-many - Retrieves multiple Product resources by their IDs\nRoute::post(\\"products/find-many\\", [ProductController::class, \\"findMany\\"])->name(\n  \\"products.find-many\\"\n);\n// Find a record or throw an exception if not found\n// http://127.0.0.1:8000/api/products/{id}/find-or-fail - Retrieves a Product resource by ID or returns a 404 error if not found\nRoute::get(\\"products/{id}/find-or-fail\\", [\n  ProductController::class,\n  \\"findOrFail\\",\n])->name(\\"products.find-or-fail\\");\n// Group records by a specific column\n// http://127.0.0.1:8000/api/products/group-by - Groups Product resources by a specified column\nRoute::get(\\"products/group-by\\", [ProductController::class, \\"groupBy\\"])->name(\n  \\"products.group-by\\"\n);\n// Retrieve the latest record based on a column\n// http://127.0.0.1:8000/api/products/latest - Retrieves the latest Product resource based on a timestamp column\nRoute::get(\\"products/latest\\", [ProductController::class, \\"latest\\"])->name(\n  \\"products.latest\\"\n);\n// Retrieve the oldest record based on a column\n// http://127.0.0.1:8000/api/products/oldest - Retrieves the oldest Product resource based on a timestamp column\nRoute::get(\\"products/oldest\\", [ProductController::class, \\"oldest\\"])->name(\n  \\"products.oldest\\"\n);\n// Order records by a specific column and direction\n// http://127.0.0.1:8000/api/products/order-by - Retrieves Product resources ordered by a specified column and direction\nRoute::get(\\"products/order-by\\", [ProductController::class, \\"orderBy\\"])->name(\n  \\"products.order-by\\"\n);\n// Retrieve random records\n// http://127.0.0.1:8000/api/products/random - Retrieves random Product resources\nRoute::get(\\"products/random\\", [ProductController::class, \\"random\\"])->name(\n  \\"products.random\\"\n);\n// Retrieve only soft-deleted records\n// http://127.0.0.1:8000/api/products/only-trashed - Retrieves only soft-deleted Product resources\nRoute::get(\\"products/only-trashed\\", [\n  ProductController::class,\n  \\"onlyTrashed\\",\n])->name(\\"products.only-trashed\\");\n// Restore a soft-deleted record by ID\n// http://127.0.0.1:8000/api/products/{id}/restore - Restores a soft-deleted Product resource by ID\nRoute::put(\\"products/{id}/restore\\", [\n  ProductController::class,\n  \\"restore\\",\n])->name(\\"products.restore\\");\n// Soft delete a specific record by ID\n// http://127.0.0.1:8000/api/products/{id}/soft-delete - Marks a Product resource as deleted without removing it from the database\nRoute::delete(\\"products/{id}/soft-delete\\", [\n  ProductController::class,\n  \\"softDelete\\",\n])->name(\\"products.soft-delete\\");\n// Retrieve records excluding soft-deleted ones\n// http://127.0.0.1:8000/api/products/without-trashed - Retrieves Product resources excluding soft-deleted ones\nRoute::get(\\"products/without-trashed\\", [\n  ProductController::class,\n  \\"withoutTrashed\\",\n])->name(\\"products.without-trashed\\");\n// Retrieve all records including soft-deleted ones\n// http://127.0.0.1:8000/api/products/with-trashed - Retrieves all Product resources including soft-deleted ones\nRoute::get(\\"products/with-trashed\\", [\n  ProductController::class,\n  \\"withTrashed\\",\n])->name(\\"products.with-trashed\\");\n\n// Resource routes for Product\nRoute::apiResource(\\"products\\", ProductController::class);"
            },
