r(Request $request, int $id)\n  {\n    $customer = $this->repository->getCustomer(\n      $id,\n      $request->query(\\"column\\"),\n      $request->query(\\"direction\\", \\"asc\\")\n    );\n    return response()->json($customer);\n  }\n}"
