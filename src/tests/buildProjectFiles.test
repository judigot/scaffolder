                "content": "<?php\n\nuse Illuminate\\Support\\Facades\\Route;\nuse App\\Http\\Controllers\\PostController;\n\n// Custom routes for Post\nRoute::get(\\"posts/{id}/user\\", [PostController::class, \\"getUser\\"])->name(\n  \\"posts.user\\"\n);\n\n// Base routes\n// Chunk records for processing\n// http://127.0.0.1:8000/api/posts/chunk - Processes data in chunks for better performance and memory usage\nRoute::post(\\"posts/chunk\\", [PostController::class, \\"chunk\\"])->name(\n  \\"posts.chunk\\"\n);\n// Process each record individually\n// http://127.0.0.1:8000/api/posts/each - Process each Post record individually\nRoute::post(\\"posts/each\\", [PostController::class, \\"each\\"])->name(\\"posts.each\\");\n// Find or create a record\n// http://127.0.0.1:8000/api/posts/first-or-create - Finds a Post record or creates it if not found\nRoute::post(\\"posts/first-or-create\\", [\n  PostController::class,\n  \\"firstOrCreate\\",\n])->name(\\"posts.first-or-create\\");\n// Find or return a new record instance\n// http://127.0.0.1:8000/api/posts/first-or-new - Finds a Post record or returns a new instance if not found\nRoute::post(\\"posts/first-or-new\\", [PostController::class, \\"firstOrNew\\"])->name(\n  \\"posts.first-or-new\\"\n);\n// Retrieve related models\n// http://127.0.0.1:8000/api/posts/get-with-relations - Retrieves Post resources with their related models\nRoute::get(\\"posts/get-with-relations\\", [\n  PostController::class,\n  \\"getWithRelations\\",\n])->name(\\"posts.with-relations\\");\n// Retrieve a list of specific column values\n// http://127.0.0.1:8000/api/posts/pluck - Retrieves a list of specific column values from Post resources\nRoute::get(\\"posts/pluck\\", [PostController::class, \\"pluck\\"])->name(\n  \\"posts.pluck\\"\n);\n// Filter records between two values\n// http://127.0.0.1:8000/api/posts/where-between - Filters Post resources where a column's value is between two specified values\nRoute::post(\\"posts/where-between\\", [\n  PostController::class,\n  \\"whereBetween\\",\n])->name(\\"posts.where-between\\");\n// Filter records based on a set of values\n// http://127.0.0.1:8000/api/posts/where-in - Retrieves Post resources where a column's value is in a given array\nRoute::post(\\"posts/where-in\\", [PostController::class, \\"whereIn\\"])->name(\n  \\"posts.where-in\\"\n);\n// Filter records excluding a set of values\n// http://127.0.0.1:8000/api/posts/where-not-in - Retrieves Post resources where a column's value is not in a given array\nRoute::post(\\"posts/where-not-in\\", [PostController::class, \\"whereNotIn\\"])->name(\n  \\"posts.where-not-in\\"\n);\n// Create multiple records in a transaction with rollback support\n// http://127.0.0.1:8000/api/posts/batch-create  - Creates multiple records in a single transaction with rollback support\nRoute::post(\\"posts/batch-create \\", [\n  PostController::class,\n  \\"batchCreateWithTransaction\\",\n])->name(\\"posts.batch-create-transaction\\");\n// Batch update multiple records\n// http://127.0.0.1:8000/api/posts/batch-update - Updates multiple Post records in a single request\nRoute::post(\\"posts/batch-update\\", [PostController::class, \\"batchUpdate\\"])->name(\n  \\"posts.batch-update\\"\n);\n// Create or update a record\n// http://127.0.0.1:8000/api/posts/update-or-create - Updates existing records or creates new ones if they don't exist\nRoute::post(\\"posts/update-or-create\\", [\n  PostController::class,\n  \\"updateOrCreate\\",\n])->name(\\"posts.update-or-create\\");\n// Count records by criteria\n// http://127.0.0.1:8000/api/posts/count?post_id=value&user_id=value - Counts Post resources matching specified criteria\nRoute::get(\\"posts/count\\", [PostController::class, \\"count\\"])->name(\n  \\"posts.count\\"\n);\n// Check if a record exists\n// http://127.0.0.1:8000/api/posts/exists?post_id=value&user_id=value - Checks if a Post resource exists based on provided criteria\nRoute::get(\\"posts/exists\\", [PostController::class, \\"exists\\"])->name(\n  \\"posts.exists\\"\n);\n// Find a record by specific attributes\n// http://127.0.0.1:8000/api/posts/find-by-attributes?post_id=1&post_id=value - Finds Post resources matching specific attributes\nRoute::get(\\"posts/find-by-attributes\\", [\n  PostController::class,\n  \\"findByAttributes\\",\n])->name(\\"posts.find-by-attributes\\");\n// Paginate records\n// http://127.0.0.1:8000/api/posts/paginate?page=1&per_page=10&post_id=value&sort=user_id&direction=desc - Returns paginated Post resources with pagination metadata\nRoute::get(\\"posts/paginate\\", [PostController::class, \\"paginate\\"])->name(\n  \\"posts.paginate\\"\n);\n// Search records\n// http://127.0.0.1:8000/api/posts/search?query=value&columns[]=post_id&columns[]=user_id - Searches for Post resources based on provided criteria\nRoute::get(\\"posts/search\\", [PostController::class, \\"search\\"])->name(\n  \\"posts.search\\"\n);\n// Find multiple records by their IDs\n// http://127.0.0.1:8000/api/posts/find-many - Retrieves multiple Post resources by their IDs\nRoute::post(\\"posts/find-many\\", [PostController::class, \\"findMany\\"])->name(\n  \\"posts.find-many\\"\n);\n// Find a record or throw an exception if not found\n// http://127.0.0.1:8000/api/posts/{id}/find-or-fail - Retrieves a Post resource by ID or returns a 404 error if not found\nRoute::get(\\"posts/{id}/find-or-fail\\", [\n  PostController::class,\n  \\"findOrFail\\",\n])->name(\\"posts.find-or-fail\\");\n// Group records by a specific column\n// http://127.0.0.1:8000/api/posts/group-by - Groups Post resources by a specified column\nRoute::get(\\"posts/group-by\\", [PostController::class, \\"groupBy\\"])->name(\n  \\"posts.group-by\\"\n);\n// Retrieve the latest record based on a column\n// http://127.0.0.1:8000/api/posts/latest - Retrieves the latest Post resource based on a timestamp column\nRoute::get(\\"posts/latest\\", [PostController::class, \\"latest\\"])->name(\n  \\"posts.latest\\"\n);\n// Retrieve the oldest record based on a column\n// http://127.0.0.1:8000/api/posts/oldest - Retrieves the oldest Post resource based on a timestamp column\nRoute::get(\\"posts/oldest\\", [PostController::class, \\"oldest\\"])->name(\n  \\"posts.oldest\\"\n);\n// Order records by a specific column and direction\n// http://127.0.0.1:8000/api/posts/order-by - Retrieves Post resources ordered by a specified column and direction\nRoute::get(\\"posts/order-by\\", [PostController::class, \\"orderBy\\"])->name(\n  \\"posts.order-by\\"\n);\n// Retrieve random records\n// http://127.0.0.1:8000/api/posts/random - Retrieves random Post resources\nRoute::get(\\"posts/random\\", [PostController::class, \\"random\\"])->name(\n  \\"posts.random\\"\n);\n// Retrieve only soft-deleted records\n// http://127.0.0.1:8000/api/posts/only-trashed - Retrieves only soft-deleted Post resources\nRoute::get(\\"posts/only-trashed\\", [PostController::class, \\"onlyTrashed\\"])->name(\n  \\"posts.only-trashed\\"\n);\n// Restore a soft-deleted record by ID\n// http://127.0.0.1:8000/api/posts/{id}/restore - Restores a soft-deleted Post resource by ID\nRoute::put(\\"posts/{id}/restore\\", [PostController::class, \\"restore\\"])->name(\n  \\"posts.restore\\"\n);\n// Soft delete a specific record by ID\n// http://127.0.0.1:8000/api/posts/{id}/soft-delete - Marks a Post resource as deleted without removing it from the database\nRoute::delete(\\"posts/{id}/soft-delete\\", [\n  PostController::class,\n  \\"softDelete\\",\n])->name(\\"posts.soft-delete\\");\n// Retrieve records excluding soft-deleted ones\n// http://127.0.0.1:8000/api/posts/without-trashed - Retrieves Post resources excluding soft-deleted ones\nRoute::get(\\"posts/without-trashed\\", [\n  PostController::class,\n  \\"withoutTrashed\\",\n])->name(\\"posts.without-trashed\\");\n// Retrieve all records including soft-deleted ones\n// http://127.0.0.1:8000/api/posts/with-trashed - Retrieves all Post resources including soft-deleted ones\nRoute::get(\\"posts/with-trashed\\", [PostController::class, \\"withTrashed\\"])->name(\n  \\"posts.with-trashed\\"\n);\n\n// Resource routes for Post\nRoute::apiResource(\\"posts\\", PostController::class);"
            }
        ]
    }
]
    `;
    const userFiles = convertLocalFilesToIStructure('src/files');
    const buildResult = await buildProjectFiles(
      '/Projects/App Generator - Database Schema/structure.yaml',
      userFiles,
      masterSchema,
      formData,
    );
    const result = buildResult.structure;
    const clean = (str: string) =>
      str
        .replace(/\\\\/g, '\\') // replace double backslash with single backslash
        .replace(/\\n/g, '') // remove literal "\n"
        .replace(/"/g, "'") // replace double quotes with single quotes
        .replace(/\s+/g, ''); // remove all whitespace

    expect(clean(JSON.stringify(result))).toEqual(clean(expectation));
  });

