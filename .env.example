# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Supabase
# DATABASE_URL="postgresql://postgres:<password>@db.<host>.supabase.co:<port>/<database>"

# Local MySQL
DATABASE_URL="mysql://<username>:<password>@<host>:<port>/<database>"

# Local PostgreSQL
# DATABASE_URL="postgresql://root:123@localhost:5432/bigbang"

DB_DATABASE=scaffolder
DB_USERNAME=scaffolder
DB_PASSWORD=scaffolder123
POSTGRESQL_PORT=15432
MYSQL_PORT=13306
NGINX_PORT=1214

VITE_AUTH0_DOMAIN=YOUR_AUTH0_APP_DOMAIN
VITE_AUTH0_CLIENT_ID=YOUR_AUTH0_APP_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://your-app-name-api

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

ENCRYPTION_KEY=

OPENCODE_URL=http://127.0.0.1:4096
DISABLED_OPENCODE_SERVER_USERNAME=opencode
DISABLED_OPENCODE_SERVER_PASSWORD=

AUTH0_MANAGEMENT_API_CLIENT_ID=
AUTH0_MANAGEMENT_API_CLIENT_SECRET=

GITHUB_APP_ID=1234567
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY----- ... -----END RSA PRIVATE KEY-----
# GITHUB_APP_INSTALLATION_ID=

# Agent callers (Cursor, Claude, Codex) send this as: Authorization: Bearer <token>
# This is not an Auth0 login and not the GitHub App private key.
SCAFFOLDER_AGENT_API_KEY=

NODE_ENV="development"
ENABLE_EXPERIMENTAL_COREPACK=1

# VITE_BACKEND_HOST - Controls how frontend makes API calls
# - "http://localhost" for local development (Vite proxy handles /api routing)
# - "" (empty) for EC2/production with Nginx (Nginx handles /api routing)
VITE_BACKEND_HOST="http://localhost"
VITE_API_URL="api"
VITE_BACKEND_PORT=3000 # Production port

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
